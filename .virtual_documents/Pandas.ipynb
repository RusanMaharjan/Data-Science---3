'''
- Used for Data cleaning, feature engineering, data analysis
'''





import pandas as pd


# 1D -> Series
# 2D -> DataFrame





alphabets = pd.Series(['A', 'B', 'C', 'D', 'E', 'F'], index=['aa', 'bb', 'cc', 'dd', 'ee', 'ff'])
alphabets


'''
Alias for Index
--------------
for column:
Columns = ['name1', 'name2', 'name3', ..., 'name_n']

for row:
index = ['name1', 'name2', 'name3', ..., 'name_n']
'''


products = pd.DataFrame([
    ['Watch', 'NavyForce', 2018, 'Rs.35000'],
    ['TV', 'MI', 2022, 'Rs.45000'],
    ['Laptop', 'HP', 2024, 'Rs.150000'],
    ['Mobile', 'Samsung', 2024, 'Rs.150000']
], columns = ['Product Name', 'Brand', 'Model Year', 'Price'],
    index=['A', 'B', 'C', 'D'])
products


alphabets[0:3]








'''
Loc -> Location
ILoc -> Integer Location
'''


products.iloc[1:, 1:3]


products.loc['B':'D', 'Brand':'Model Year']


products.loc[
    ['A', 'D'],
    ['Product Name', 'Price']
]


products.iloc[
    [0, 3],
    [0, 3]
]


products.iloc[:,0]


# information -> info()

products.info()


products.shape


products.size


products.ndim





