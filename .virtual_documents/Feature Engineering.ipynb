'''
- StandardScaler
- Label Encoder
- One Hot Encoder
- Min Max Scaler
- Robust Scaler
'''


import numpy as np
# Michael Albert


def splitName(name):
    value = name.strip().split() # ['Michael', 'middle', 'Albert']

    if len(value) == 1:
        return pd.Series([value[0], np.nan, np.nan])
    elif len(value) == 2:
        return pd.Series([value[0], np.nan, value[1]])
    else:
        return pd.Series([value[0], value[1], value[2]])


df[['M_first_name', 'M_middle_name', 'M_last_name']] = df['ManagerName'].apply(splitName)


