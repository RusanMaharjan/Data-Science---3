'''
Group by
Aggregate Functions -> (mean, max, min, count, sum)
Order by -> sort_values(ascending=True/False, by=column_name, ignore_index=True/False (default))
rename -> dictionary {'current_column_name':'replaced_column_name'}
agg -> for analysis of multiple aggregate function columns
'''


import pandas as pd


df = pd.read_csv('hr_cleaned_data.csv')


df.head()


df.columns


# Find total employees hired through each Recruitment Source.
'''
    Syntax
    -------
    -> dataframe.groupby(column_name)[column_name].agg_function()
'''
# df['RecruitmentSource'].unique()


emp_recruitement = df.groupby('RecruitmentSource')['EmpID'].count()


emp_recruitement


emp_recruitement = df.groupby('RecruitmentSource')['EmpID'].count().reset_index().rename(
    columns = {'EmpID': 'Total Employees', 'RecruitmentSource': 'Recruitment Source'}
).sort_values(ascending=False, by='Total Employees', ignore_index=True)
emp_recruitement.tail()


emp_recruitement = df.groupby('RecruitmentSource')['EmpID'].count().rename('Total Employees').rename_axis('Recruitment Source')
format_data = emp_recruitement.to_markdown(numalign='center', stralign='center')


print(format_data)


# Find total employees hired through each Recruitment Source and Gender.
recruitment_gender = df.groupby(['RecruitmentSource', 'Gender'])['EmpID'].count().reset_index().rename(
    columns = {'RecruitmentSource': 'Recruitment Source', 'EmpID':'Total Employees'}
)
recruitment_gender


def changeCurrency(dataframe, prefix, *args):
    for col in args:
        dataframe[col] = dataframe[col].map(f'{prefix}''{:,.2f}'.format)


# Find total employees hired and total salary distribution of employees by each Recruitment Source and Gender.
rec_gen_sal = df.groupby(['RecruitmentSource', 'Gender']).agg(
    Total_Employees = ('EmpID', 'count'),
    Total_Salary = ('Salary', 'sum'),
    Max_Salary = ('Salary', 'max'),
    Min_Salary = ('Salary', 'min')
).reset_index()
# rec_gen_sal['Total_Salary'] = rec_gen_sal['Total_Salary'].map('${:,.2f}'.format)
changeCurrency(rec_gen_sal, 'Rs.', 'Total_Salary', 'Max_Salary', 'Min_Salary')
rec_gen_sal


rec_gen_sal.info()





# Extract a metric profile for each performance rating tier. For each tier, find the 
# typical number of absences, the standard survey score for employee commitment, and the 
# worst-case scenario for short-term tardiness (DaysLateLast30).
emp_performance = df.groupby('PerformanceScore').agg(
    Typical_Absences = ('Absences', 'mean'),
    Emp_Survey = ('EngagementSurvey', 'mean'),
    Total_Late_Days = ('DaysLateLast30', 'sum')
).reset_index()
emp_performance


df.columns


## Find total number of employees hired in each year.
emp_hired = df.groupby('HireYear')['EmpID'].count().reset_index().rename(
    columns = {'EmpID': 'Total Employees'}
)
# pct_change()
emp_hired['Hire%'] = round(emp_hired['Total Employees'].pct_change().fillna(0), 2)*100
emp_hired['Hire%'] = emp_hired['Hire%'].map('{:,.2f}%'.format)
emp_hired

# DateTime -> YTD (Year to Date), MTD (Month to Date), DTD (Day to Date)





# select HireMonth_Name, EmpID as Total Employees from employees
# group by 'HireMonth', 'HireMonth_Name';


emp_month_hire = df.groupby(['HireMonth', 'HireMonth_Name'])['EmpID'].count().reset_index().rename(
    columns = {'EmpID': 'Total Employees'}
)[['HireMonth_Name', 'Total Employees']]
emp_month_hire





# Pandas Category -> pd.Categorical(column_name, categories)
days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
df['HireDay_Name'] = pd.Categorical(df['HireDay_Name'], categories=days)
df['HireDay_Name'].unique()


emp_day_hire = df.groupby('HireDay_Name', observed=False)['EmpID'].count().reset_index().rename(
    columns = {'EmpID': 'Total Employees'}
)
emp_day_hire





