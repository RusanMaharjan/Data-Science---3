import pandas as pd


df = pd.read_excel('Dataset/financial_loan_data.xlsx')
df.head()


df.info()


df.isnull().sum()





df.fillna({'emp_title': 'Unknown Title'}, inplace=True)





df['Issue_Month'] = df['issue_date'].dt.month
df['I_month_name'] = df['issue_date'].dt.month_name()


'''
Growth Percentage
===================
current_value -> Current Month Value -> MTD (Month to Date)
baseline_value -> Previous Month Value -> PMTD (Previous Month to Date)

MoM (Month over Month) = ((current_value - baseline_value)/baseline_value)*100
'''


current_month = 12
previous_month = 11








total_applicants = df['id'].count()
# MTD_total_applicants = df[df.loc[:,'Issue_Month'] == 12]['id'].count()
MTD_total_applicants = df[df['Issue_Month'] == 12]['id'].count()
PMTD_total_applicants = df[df['Issue_Month'] == 11]['id'].count()
MoM_total_applicants = round(((MTD_total_applicants - PMTD_total_applicants) / PMTD_total_applicants)*100, 2)


print(f'Total Applicants: {total_applicants}')
print(f'MTD Total Applicants: {MTD_total_applicants}')
print(f'PMTD Total Applicants: {PMTD_total_applicants}')
print(f'MoM Total Applicants: {MoM_total_applicants}%')





